# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Shared code required to create a new operator account (existing operators
# don't need it to log in). Distribute out-of-band (e.g. WhatsApp) to your
# team; rotate by changing this value and redeploying.
INVITE_CODE=your-shared-invite-code
