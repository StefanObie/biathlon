# Update these with your Supabase details from your project settings > API
# https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key


# Server-only (never NEXT_PUBLIC_). Invitations (#34): the invite_members_email secret key
# creates the invitee's session from an Invitation link, and ZeptoMail sends
# the email from invites@crossland.co.za.
INVITE_MEMBERS_EMAIL_SECRET_KEY=your-invite-members-email-secret-key
ZEPTOMAIL_TOKEN=your-zeptomail-send-mail-token

# Server-only. Swim import (#71, ADR 0005): the JSON key of the service account
# that reads every Organization's Swim folder, on one line as Google downloads it.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","client_email":"swim-reader@biathlon-swim-importer.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}
